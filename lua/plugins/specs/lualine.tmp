return {
  "stevearc/conform.nvim",
  event = "VeryLazy", -- ✅ Грузится сразу, чтобы <leader>cf работал с первой секунды
  cmd = { "ConformInfo" },

  opts = {
    formatters_by_ft = {
      go = { "goimports", "gofumpt" },
      javascript = { "prettier" },
      typescript = { "prettier" },
      javascriptreact = { "prettier" },
      typescriptreact = { "prettier" },
      html = { "prettier" },
      css = { "prettier" },
      scss = { "prettier" },
      json = { "prettier" },
      markdown = { "prettier" },
      lua = { "stylua" },
    },

    format_on_save = {
      timeout_ms = 3000,
      async = false,           -- 🔴 Критично: синхронно для атомарного :w
      lsp_format = "never",    -- ✅ Никогда не делегировать сохранение LSP
    },

    default_format_opts = {
      lsp_format = "never",    -- ✅ Глобальный запрет LSP-форматирования
    },

    formatters = {
      stylua = {
        prepend_args = {
          "--config-path",
          vim.fn.stdpath("config") .. "/stylua.toml",
        },
      },
    },

    log_level = vim.log.levels.WARN,
  },

  config = function(_, opts)
    require("conform").setup(opts)

    -- 🎯 Ручное форматирование (строго через conform, без LSP-fallback)
    vim.keymap.set({ "n", "v" }, "<leader>cf", function()
      require("conform").format({
        async = true,
        lsp_format = "never",  -- ✅ Явный запрет LSP при ручном вызове
      })
    end, { desc = "Format code" })
  end,
}
