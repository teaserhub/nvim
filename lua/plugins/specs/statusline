return {
    -- ═══════════════════════════ MINI.ICONS (зависимость) ═══════════════════════════
    {
        "echasnovski/mini.icons",
        version = "*",
        lazy = true,
    },

    -- ═══════════════════════════ MINI.STATUSLINE (НИЗ) ═══════════════════════════
-- ═══════════════════════════ MINI.STATUSLINE (НИЗ) ═══════════════════════════
{
    "echasnovski/mini.statusline",
    version = "*",
    event = "VeryLazy",
    config = function()
        local statusline = require("mini.statusline")
        
        -- 🎨 Хайлайты только для статусов редактирования
        vim.api.nvim_set_hl(0, "StatusLineMode",      { fg = "#282c34", bg = "#98c379", bold = true }) -- NORMAL (зелёный)
        vim.api.nvim_set_hl(0, "StatusLineModeInsert", { fg = "#282c34", bg = "#61afef", bold = true }) -- INSERT (синий)
        vim.api.nvim_set_hl(0, "StatusLineModeVisual", { fg = "#282c34", bg = "#c678dd", bold = true }) -- VISUAL (фиолетовый)
        vim.api.nvim_set_hl(0, "StatusLineModeCmd",    { fg = "#282c34", bg = "#e5c07b", bold = true }) -- COMMAND (жёлтый)
        vim.api.nvim_set_hl(0, "StatusLineModified",   { fg = "#e5c07b" })                              -- Изменён (жёлтый)
        vim.api.nvim_set_hl(0, "StatusLineNormal",     { fg = "#abb2bf" })                              -- Обычный текст

        statusline.setup({
            use_icons = true,
            content = {
                active = function()
                    -- 1. Режим с цветом
                    local mode = vim.api.nvim_get_mode().mode:sub(1, 1)
                    local mode_text, mode_hl
                    if mode == "i" then
                        mode_text, mode_hl = " INSERT ", "StatusLineModeInsert"
                    elseif mode == "v" or mode == "V" then
                        mode_text, mode_hl = " VISUAL ", "StatusLineModeVisual"
                    elseif mode == "c" then
                        mode_text, mode_hl = " CMD ", "StatusLineModeCmd"
                    else
                        mode_text, mode_hl = " NORMAL ", "StatusLineMode"
                    end
                    
                    -- 2. Имя файла
                    local file = vim.fn.expand("%:t")
                    if file == "" then file = "[No Name]" end
                    
                    -- 3. Статус изменённости с цветом
                    local modified = ""
                    if vim.bo.modified then
                        modified = "%#StatusLineModified# ●%*"
                    end
                    
                    -- 4. Позиция
                    local pos = "%l/%L:%c   %p%%"
                    
                    -- 🔧 Собираем строку
                    return string.format(
                        "%%#%s#%s%%*  %s%s %%#StatusLineNormal#%%= %s",
                        mode_hl, mode_text, file, modified, pos
                    )
                end,
            },
        })
    end,
},
    -- ═══════════════════════════ MINI.TABLINE (ВЕРХ) ═══════════════════════════
    {
        "echasnovski/mini.tabline",
        version = "*",
        event = "VeryLazy",
        config = function()
            require("mini.tabline").setup({
                format = function(bufnr, is_current, is_visible)
                    local name = vim.fn.fnamemodify(vim.api.nvim_buf_get_name(bufnr), ":t")
                    if name == "" then name = "[No Name]" end

                    -- Префикс для текущего буфера
                    local prefix = is_current and "▸ " or "  "

                    -- Флаг изменённости
                    local modified = vim.bo[bufnr].modified and " ●" or ""

                    -- Git-статус (простая иконка)
                    local git = ""
                    local ok, gitsigns = pcall(function()
                        return vim.b[bufnr].gitsigns_status_dict
                    end)
                    if ok and gitsigns then
                        if (gitsigns.added or 0) > 0 then
                            git = " +"
                        elseif (gitsigns.changed or 0) > 0 then
                            git = " ~"
                        elseif (gitsigns.removed or 0) > 0 then
                            git = " -"
                        end
                    end

                    return prefix .. name .. modified .. git
                end,

                -- Простые настройки
                show_icons = false,
                set_vim_settings = true,
            })
            vim.opt.showtabline = 2
        end,
    },
}
